{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger public book rows (one document per table)",
  "description": "Per-table row schemas for the public book. Each table file is JSON Lines; every line must validate against the row schema named for its table.",
  "$defs": {
    "minor": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "amount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},
    "rate": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "id": {"type": "string", "minLength": 2, "maxLength": 48},
    "nullableId": {"type": ["string", "null"]},
    "nullableTimestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},

    "je_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "account_id", "debit_minor", "credit_minor", "currency",
                   "fx_rate_decimal", "functional_debit_minor", "functional_credit_minor",
                   "counterparty_id", "analytic_tag"],
      "properties": {
        "line_id": {"$ref": "#/$defs/id"},
        "account_id": {"$ref": "#/$defs/id"},
        "debit_minor": {"$ref": "#/$defs/amount"},
        "credit_minor": {"$ref": "#/$defs/amount"},
        "currency": {"$ref": "#/$defs/currency"},
        "fx_rate_decimal": {"$ref": "#/$defs/rate"},
        "functional_debit_minor": {"$ref": "#/$defs/amount"},
        "functional_credit_minor": {"$ref": "#/$defs/amount"},
        "counterparty_id": {"$ref": "#/$defs/nullableId"},
        "analytic_tag": {"$ref": "#/$defs/nullableId"}
      }
    },
    "journal_entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["je_id", "timestamp", "posting_period", "source_document_id", "description", "lines"],
      "properties": {
        "je_id": {"$ref": "#/$defs/id"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "posting_period": {"type": "string", "pattern": "^[0-9]{4}-(M[0-9]{2}|Q[1-4]|FY)$"},
        "source_document_id": {"$ref": "#/$defs/nullableId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 400},
        "lines": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/je_line"}}
      }
    },
    "invoices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "counterparty_id", "issue_timestamp", "service_start", "service_end",
                   "due_timestamp", "currency", "total_minor", "tax_minor", "line_items", "status"],
      "properties": {
        "doc_id": {"$ref": "#/$defs/id"},
        "counterparty_id": {"$ref": "#/$defs/id"},
        "issue_timestamp": {"$ref": "#/$defs/timestamp"},
        "service_start": {"$ref": "#/$defs/timestamp"},
        "service_end": {"$ref": "#/$defs/nullableTimestamp"},
        "due_timestamp": {"$ref": "#/$defs/timestamp"},
        "currency": {"$ref": "#/$defs/currency"},
        "total_minor": {"$ref": "#/$defs/amount"},
        "tax_minor": {"type": ["integer", "null"], "minimum": 0},
        "line_items": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_id", "description", "quantity_decimal", "unit_price_minor", "amount_minor", "service_reference"],
            "properties": {
              "line_id": {"$ref": "#/$defs/id"},
              "description": {"type": "string", "minLength": 1, "maxLength": 300},
              "quantity_decimal": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
              "unit_price_minor": {"type": ["integer", "null"], "minimum": 0},
              "amount_minor": {"$ref": "#/$defs/minor"},
              "service_reference": {"$ref": "#/$defs/nullableId"}
            }
          }
        },
        "status": {"type": "string", "enum": ["OPEN", "PARTIALLY_PAID", "PAID", "OVERPAID", "CREDITED", "VOID"]}
      }
    },
    "credit_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credit_note_id", "invoice_id", "counterparty_id", "timestamp", "amount_minor", "currency", "reason_code"],
      "properties": {
        "credit_note_id": {"$ref": "#/$defs/id"},
        "invoice_id": {"$ref": "#/$defs/id"},
        "counterparty_id": {"$ref": "#/$defs/id"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "amount_minor": {"$ref": "#/$defs/amount"},
        "currency": {"$ref": "#/$defs/currency"},
        "reason_code": {"type": "string", "enum": ["PRICE_ADJUSTMENT", "SERVICE_SHORTFALL", "GOODWILL", "BILLING_CORRECTION"]}
      }
    },
    "payments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pay_id", "timestamp", "counterparty_id", "currency", "amount_minor",
                   "allocations", "bank_reference", "payment_channel", "functional_amount_minor", "fx_rate_decimal"],
      "properties": {
        "pay_id": {"$ref": "#/$defs/id"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "counterparty_id": {"$ref": "#/$defs/id"},
        "currency": {"$ref": "#/$defs/currency"},
        "amount_minor": {"$ref": "#/$defs/amount"},
        "functional_amount_minor": {"$ref": "#/$defs/amount"},
        "fx_rate_decimal": {"$ref": "#/$defs/rate"},
        "allocations": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allocation_id", "document_id", "amount_minor", "allocation_timestamp"],
            "properties": {
              "allocation_id": {"$ref": "#/$defs/id"},
              "document_id": {"$ref": "#/$defs/id"},
              "amount_minor": {"$ref": "#/$defs/amount"},
              "allocation_timestamp": {"$ref": "#/$defs/timestamp"}
            }
          }
        },
        "bank_reference": {"$ref": "#/$defs/nullableId"},
        "payment_channel": {"type": "string", "enum": ["WIRE", "ACH", "CARD", "INTERNAL"]}
      }
    },
    "bank_lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank_line_id", "timestamp", "amount_minor", "currency", "direction",
                   "reference_text", "matched_payment_id", "bank_account_id", "status"],
      "properties": {
        "bank_line_id": {"$ref": "#/$defs/id"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "amount_minor": {"$ref": "#/$defs/amount"},
        "currency": {"$ref": "#/$defs/currency"},
        "direction": {"type": "string", "enum": ["IN", "OUT"]},
        "reference_text": {"type": "string", "minLength": 1, "maxLength": 200},
        "matched_payment_id": {"$ref": "#/$defs/nullableId"},
        "bank_account_id": {"$ref": "#/$defs/id"},
        "status": {"type": "string", "enum": ["MATCHED", "UNMATCHED", "EXPLAINED_NON_PAYMENT"]}
      }
    },
    "counterparties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterparty_id", "legal_name", "country_marker", "vat_marker", "payment_terms_days", "category", "name_variants"],
      "properties": {
        "counterparty_id": {"$ref": "#/$defs/id"},
        "legal_name": {"type": "string", "minLength": 3, "maxLength": 120},
        "country_marker": {"type": "string", "pattern": "^X[A-Z]$"},
        "vat_marker": {"type": "string", "pattern": "^XTV-[0-9]{8}$"},
        "payment_terms_days": {"type": "integer", "minimum": 0, "maximum": 120},
        "category": {"type": "string", "enum": ["CUSTOMER", "SUPPLIER", "BOTH"]},
        "name_variants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ru", "kk"],
          "properties": {
            "en": {"type": "string", "minLength": 1},
            "ru": {"type": "string", "minLength": 1},
            "kk": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "code", "name", "type", "normal_balance", "currency_scope"],
      "properties": {
        "account_id": {"$ref": "#/$defs/id"},
        "code": {"type": "string", "pattern": "^[0-9]{4}$"},
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "type": {"type": "string", "enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"]},
        "normal_balance": {"type": "string", "enum": ["DEBIT", "CREDIT"]},
        "currency_scope": {"type": "string", "enum": ["FUNCTIONAL", "TRANSACTIONAL"]}
      }
    },
    "fx_rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair", "effective_date", "rate_decimal", "source_code", "publication_timestamp"],
      "properties": {
        "pair": {"type": "string", "pattern": "^[A-Z]{3}/[A-Z]{3}$"},
        "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "rate_decimal": {"$ref": "#/$defs/rate"},
        "source_code": {"type": "string", "minLength": 2, "maxLength": 24},
        "publication_timestamp": {"$ref": "#/$defs/nullableTimestamp"}
      }
    }
  }
}
