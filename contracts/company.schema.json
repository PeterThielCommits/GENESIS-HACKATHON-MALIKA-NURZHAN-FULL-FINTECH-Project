{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TwinLedger Synthetic Company",
  "description": "Fully fictional synthetic company (TZ 8.1). No real entities.",
  "type": "object",
  "required": ["schema_version", "company_id", "legal_name", "name_variants", "jurisdiction_code", "timezone", "functional_currency", "supported_currencies", "fiscal_year_start", "fiscal_period_rule", "accounting_basis", "id_style", "text_profile", "company_size"],
  "additionalProperties": false,
  "patternProperties": {"^x_twinledger_.*": {}},
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "company_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "legal_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "name_variants": {
      "type": "object",
      "required": ["ru", "kk", "en"],
      "additionalProperties": false,
      "properties": {
        "ru": {"type": "string", "minLength": 1, "maxLength": 256},
        "kk": {"type": "string", "minLength": 1, "maxLength": 256},
        "en": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "jurisdiction_code": {"type": "string", "minLength": 2, "maxLength": 8},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
    "functional_currency": {"type": "string", "enum": ["KZT", "USD", "EUR", "JPY", "KWD"]},
    "supported_currencies": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "enum": ["KZT", "USD", "EUR", "JPY", "KWD"]}},
    "fiscal_year_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "fiscal_period_rule": {"type": "string", "enum": ["monthly", "quarterly"]},
    "accounting_basis": {"type": "string", "minLength": 1, "maxLength": 256},
    "id_style": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "text_profile": {"type": "string", "minLength": 1, "maxLength": 64},
    "company_size": {"type": "string", "enum": ["S", "M", "L"]}
  }
}
