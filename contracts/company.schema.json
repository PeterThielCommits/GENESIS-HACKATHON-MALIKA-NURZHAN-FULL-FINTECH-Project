{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twinledger://contracts/company.schema.json",
  "title": "Company",
  "description": "Synthetic company identity (§8.1). Fully fictional; jurisdiction codes XA-XZ are internal placeholders, not ISO assignments.",
  "schema_version": "1.0.0",
  "status": "provisional",
  "provisional_reason": "Derived from the TwinLedger v3.0 master technical specification. The organizer contract is not archived in this repository, therefore this schema is PROVISIONAL and isolated behind adapter/ (see docs/ASSUMPTIONS.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "legal_name",
    "name_variants",
    "jurisdiction_code",
    "timezone",
    "functional_currency",
    "supported_currencies",
    "fiscal_year_start",
    "fiscal_period_rule",
    "accounting_basis",
    "id_style",
    "text_profile",
    "company_size"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.defs.json#/$defs/schema_version"
    },
    "company_id": {
      "type": "string",
      "pattern": "^CO-[A-Z0-9]{6,12}$"
    },
    "legal_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Fictional legal name; must not reproduce a real legal entity."
    },
    "name_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "kk",
        "en"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "jurisdiction_code": {
      "type": "string",
      "pattern": "^X[A-Z]$",
      "description": "Reserved synthetic code XA-XZ. Documented as internal, never as an official ISO-3166 country code."
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z_]+/[A-Za-z_+0-9-]+$"
    },
    "functional_currency": {
      "$ref": "common.defs.json#/$defs/currency_code"
    },
    "supported_currencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "common.defs.json#/$defs/currency_code"
      }
    },
    "fiscal_year_start": {
      "$ref": "common.defs.json#/$defs/date_iso8601"
    },
    "fiscal_period_rule": {
      "type": "string",
      "enum": [
        "MONTHLY",
        "QUARTERLY"
      ]
    },
    "accounting_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revenue_recognition",
        "expense_recognition",
        "cutoff_rule"
      ],
      "properties": {
        "revenue_recognition": {
          "type": "string",
          "enum": [
            "SERVICE_DATE",
            "INVOICE_DATE"
          ]
        },
        "expense_recognition": {
          "type": "string",
          "enum": [
            "SERVICE_COMPLETION",
            "INVOICE_DATE"
          ]
        },
        "cutoff_rule": {
          "type": "string",
          "enum": [
            "COMPANY_LOCAL_DATE"
          ]
        }
      }
    },
    "id_style": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "text_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ru",
              "kk",
              "en"
            ]
          }
        },
        "register": {
          "type": "string",
          "enum": [
            "FORMAL",
            "NEUTRAL"
          ]
        }
      }
    },
    "company_size": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    }
  }
}
