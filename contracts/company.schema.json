{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger company",
  "x-twinledger-note": "Synthetic company identity. XA-XZ codes are internal reserved synthetic markers, NOT official ISO-3166 assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id", "legal_name", "name_variants", "jurisdiction_code", "timezone",
    "functional_currency", "supported_currencies", "fiscal_year_start",
    "fiscal_period_rule", "accounting_basis", "id_style", "text_profile",
    "company_size", "fiscal_calendar"
  ],
  "properties": {
    "company_id": {"type": "string", "pattern": "^CO-[A-Z0-9]{6,12}$"},
    "legal_name": {"type": "string", "minLength": 3, "maxLength": 120},
    "name_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru", "kk"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "ru": {"type": "string", "minLength": 1},
        "kk": {"type": "string", "minLength": 1}
      }
    },
    "jurisdiction_code": {"type": "string", "pattern": "^X[A-Z]$"},
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z_+-]+$"},
    "functional_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "supported_currencies": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{3}$"}
    },
    "fiscal_year_start": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"},
    "fiscal_period_rule": {"type": "string", "enum": ["monthly", "quarterly", "annual"]},
    "fiscal_calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period_rule", "fiscal_year_start_month", "fiscal_year_start_day", "cutoff_day_offset", "ambiguity_policy"],
      "properties": {
        "period_rule": {"type": "string", "enum": ["monthly", "quarterly", "annual"]},
        "fiscal_year_start_month": {"type": "integer", "minimum": 1, "maximum": 12},
        "fiscal_year_start_day": {"type": "integer", "minimum": 1, "maximum": 31},
        "cutoff_day_offset": {"type": "integer", "minimum": -3, "maximum": 3},
        "ambiguity_policy": {"type": "string", "enum": ["prefer_earlier", "prefer_later", "raise"]}
      }
    },
    "accounting_basis": {"type": "string", "enum": ["accrual", "modified_accrual", "cash"]},
    "id_style": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "text_profile": {"type": "string", "enum": ["ru_kk_en", "en_primary", "ru_primary"]},
    "company_size": {"type": "string", "enum": ["small", "medium", "large"]},
    "synthetic": {"type": "boolean", "const": true}
  }
}
