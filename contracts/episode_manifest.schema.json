{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TwinLedger Episode Manifest (public)",
  "description": "Public manifest. Must NOT contain finding counts, types, affected IDs, operator names, clean flags or provenance (REQ-DATA-020).",
  "type": "object",
  "required": ["schema_version", "episode_id", "contract_version", "generator_version", "config_hash", "public_files", "truth_commitment"],
  "additionalProperties": false,
  "patternProperties": {"^x_twinledger_.*": {}},
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "generator_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "truth_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_count_by_table": {"type": "object"},
        "document_count": {"type": "integer", "minimum": 0},
        "distractor_count": {"type": "integer", "minimum": 0},
        "evidence_depth": {"type": "integer", "minimum": 0},
        "tool_budget": {"type": "integer", "minimum": 1}
      }
    }
  }
}
