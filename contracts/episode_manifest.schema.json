{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger episode manifest (public)",
  "description": "Public manifest. MUST NOT disclose finding count, anomaly types, mutated IDs, operator names or mutation count (REQ-DATA-020).",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "episode_id", "difficulty", "contract_version", "schema_versions",
               "generator_version", "config_hash", "public_files", "public_digest", "commitment",
               "table_counts", "timezone", "functional_currency", "created_at_utc", "canary_scan"],
  "properties": {
    "manifest_version": {"type": "string", "const": "1.0.0"},
    "episode_id": {"type": "string", "pattern": "^EP-[A-Z0-9-]{6,40}$"},
    "difficulty": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "public_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes", "rows"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z_]+(\\.json|\\.jsonl)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "rows": {"type": "integer", "minimum": 1}
        }
      }
    },
    "public_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "commitment_hex"],
      "properties": {
        "algorithm": {"type": "string", "const": "sha256(salt||truth_digest)"},
        "commitment_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "table_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "timezone": {"type": "string"},
    "functional_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$"},
    "canary_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_version", "public_hits"],
      "properties": {
        "scan_version": {"type": "string"},
        "public_hits": {"type": "integer", "const": 0}
      }
    }
  }
}
