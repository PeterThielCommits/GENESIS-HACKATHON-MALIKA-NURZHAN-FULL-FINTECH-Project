{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger anomaly type catalog entry",
  "description": "Machine-readable taxonomy shared by generator, verifier, scorer and docs. Values are frozen for contract 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "types"],
  "properties": {
    "catalog_version": {"type": "string", "const": "1.0.0"},
    "types": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "operator_id", "operator_version", "intended_invariants",
                     "allowed_side_effects", "forbidden_invariants", "affected_id_rule",
                     "evidence_requirements", "amount_definition", "distractor_suite"],
        "properties": {
          "type": {"type": "string", "enum": ["DUPLICATE_PAYMENT", "PARTIAL_PAYMENT_ALLOCATION", "FX_RATE_MISMATCH", "PERIOD_CUTOFF"]},
          "operator_id": {"type": "string", "pattern": "^OP-[A-Z_]+$"},
          "operator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "intended_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^INV-[0-9]{2}$"}},
          "allowed_side_effects": {"type": "array", "items": {"type": "string", "pattern": "^INV-[0-9]{2}$"}},
          "forbidden_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^INV-[0-9]{2}$"}},
          "affected_id_rule": {"type": "string", "minLength": 10, "maxLength": 400},
          "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
          "amount_definition": {"type": "string", "minLength": 5, "maxLength": 300},
          "distractor_suite": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^D-[A-Z]+-[0-9]{2}$"}}
        }
      }
    }
  }
}
