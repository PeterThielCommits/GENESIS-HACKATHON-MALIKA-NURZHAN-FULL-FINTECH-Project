{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TwinLedger Verifier Report",
  "description": "Independent verifier discovery output (TZ 13.3). Contains no truth/provenance.",
  "type": "object",
  "required": ["schema_version", "episode_public_hash", "findings", "examined_public_sources", "unresolved_ambiguities", "verifier_version"],
  "additionalProperties": false,
  "patternProperties": {"^x_twinledger_.*": {}},
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "episode_public_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_sets", "explanation_code"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["DUPLICATE_PAYMENT", "PARTIAL_PAYMENT_ALLOCATION", "FX_RATE_MISMATCH", "PERIOD_CUTOFF"]},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(JE|INV|CN|PAY|BANK|FX|CP):[A-Za-z0-9._/-]+$"}},
          "claimed_amount_minor": {"type": "integer"},
          "currency": {"type": "string", "enum": ["KZT", "USD", "EUR", "JPY", "KWD"]},
          "evidence_sets": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "string", "pattern": "^(JE|INV|CN|PAY|BANK|FX|CP):[A-Za-z0-9._/-]+$"}}},
          "proof_graph_ref": {"type": "string", "maxLength": 256},
          "explanation_code": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "examined_public_sources": {"type": "array", "items": {"type": "string"}},
    "unresolved_ambiguities": {"type": "array", "items": {"type": "string"}},
    "verifier_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "deterministic_diagnostics": {"type": "object"}
  }
}
