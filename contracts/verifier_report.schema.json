{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger verifier report",
  "description": "Report produced by the independent verifier from public data only (REQ-VER-*). Contains no provenance and is safe to exchange after discovery freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "verifier_version", "episode_id", "public_digest", "findings", "checked_invariants", "notes"],
  "properties": {
    "report_version": {"type": "string", "const": "1.0.0"},
    "verifier_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "episode_id": {"type": "string"},
    "public_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verifier_finding_id", "type", "affected_ids", "amount_minor", "currency",
                     "invariant_id", "evidence_sets", "minimal_evidence_size", "confidence_basis"],
        "properties": {
          "verifier_finding_id": {"type": "string", "minLength": 3},
          "type": {"type": "string", "enum": ["DUPLICATE_PAYMENT", "PARTIAL_PAYMENT_ALLOCATION", "FX_RATE_MISMATCH", "PERIOD_CUTOFF"]},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "amount_minor": {"type": "integer", "minimum": 0},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "invariant_id": {"type": "string", "pattern": "^INV-[0-9]{2}$"},
          "evidence_sets": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
          "minimal_evidence_size": {"type": "integer", "minimum": 1},
          "confidence_basis": {"type": "string", "minLength": 5, "maxLength": 300}
        }
      }
    },
    "checked_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^INV-[0-9]{2}$"}},
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 300}}
  }
}
