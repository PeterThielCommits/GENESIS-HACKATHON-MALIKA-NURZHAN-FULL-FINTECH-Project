{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger tool response (public environment API, bounded)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "tool", "data", "budget"],
  "properties": {
    "ok": {"type": "boolean"},
    "tool": {"type": "string", "enum": ["list_records", "get_record", "get_document", "get_policy", "submit_findings", "request_hint"]},
    "data": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^E_[A-Z_]+$"},
        "message": {"type": "string", "maxLength": 400}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps_used", "steps_remaining"],
      "properties": {
        "steps_used": {"type": "integer", "minimum": 0},
        "steps_remaining": {"type": "integer", "minimum": 0}
      }
    },
    "next_cursor": {"type": ["string", "null"]}
  }
}
