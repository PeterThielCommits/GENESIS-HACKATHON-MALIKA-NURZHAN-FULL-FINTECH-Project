{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinLedger sealed truth",
  "$defs": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "id": {"type": "string", "minLength": 2, "maxLength": 48},
    "invariant_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "entity_key", "expected_delta_minor", "currency", "direction", "tolerance_minor", "side_effect_class"],
      "properties": {
        "invariant_id": {"type": "string", "pattern": "^INV-[0-9]{2}$"},
        "entity_key": {"type": "string", "minLength": 2, "maxLength": 200},
        "expected_delta_minor": {"type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "direction": {"type": "string", "enum": ["over", "under", "mismatch", "invalid"]},
        "tolerance_minor": {"type": "integer", "minimum": 0},
        "side_effect_class": {"type": "string", "enum": ["intended", "allowed_side_effect"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_id", "type", "affected_ids", "amount_minor", "currency",
                   "tolerance_minor", "evidence_sets", "minimal_evidence_size",
                   "invariant_signature", "operator_version", "depends_on",
                   "optimal_steps_model_id", "optimal_steps"],
      "properties": {
        "truth_id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "enum": ["DUPLICATE_PAYMENT", "PARTIAL_PAYMENT_ALLOCATION", "FX_RATE_MISMATCH", "PERIOD_CUTOFF"]},
        "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "amount_minor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "currency": {"$ref": "#/$defs/currency"},
        "tolerance_minor": {"type": "integer", "minimum": 0, "maximum": 100},
        "evidence_sets": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        },
        "minimal_evidence_size": {"type": "integer", "minimum": 1},
        "invariant_signature": {"$ref": "#/$defs/invariant_signature"},
        "operator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "optimal_steps_model_id": {"type": "string", "minLength": 3},
        "optimal_steps": {"type": ["integer", "null"], "minimum": 0},
        "distractor_ids": {"type": "array", "items": {"type": "string", "pattern": "^D-[A-Z]+-[0-9]{2}$"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["truth_version", "episode_id", "mode", "findings", "diff_summary", "distractors"],
  "properties": {
    "truth_version": {"type": "string", "const": "1.0.0"},
    "episode_id": {"type": "string", "pattern": "^EP-[A-Z0-9-]{6,40}$"},
    "mode": {"type": "string", "enum": ["CLEAN", "ANOMALOUS"]},
    "findings": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/finding"}},
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "modified", "unchanged_tables_digest"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "modified": {"type": "integer", "minimum": 0},
        "unchanged_tables_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "distractors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distractor_id", "distractor_of", "distinguishing_fact", "public_evidence_ids"],
        "properties": {
          "distractor_id": {"type": "string", "pattern": "^D-[A-Z]+-[0-9]{2}$"},
          "distractor_of": {"type": "string", "enum": ["DUPLICATE_PAYMENT", "PARTIAL_PAYMENT_ALLOCATION"]},
          "distinguishing_fact": {"type": "string", "minLength": 8, "maxLength": 400},
          "public_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  }
}
